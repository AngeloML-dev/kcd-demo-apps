# =============================================================
# KCD Peru 2026 — Variables de entorno
# Copiar a .env y llenar los valores marcados con <<<
# =============================================================

# ── Ollama (LLM local) ──────────────────────────────────────
# IMPORTANTE: Requiere Ollama 0.19+ con MLX en Apple Silicon = 2x mas rapido
# Instalar/actualizar: brew upgrade ollama
OLLAMA_URL=http://localhost:11434

# ── Thinking mode (razonamiento interno del modelo) ────────
# true  = el modelo razona antes de responder (mas preciso, mas lento ~15-30s)
# false = respuesta directa sin razonamiento (rapido ~1-3s, ideal para demos)
OLLAMA_THINK=false

# ── Aceleracion Apple Silicon ─────────────────────────────
# Habilita Flash Attention y optimizaciones avanzadas
# M4: Flash Attention + Metal optimizado (prefill 2-6x mas rapido)
# M5+: MLX nativo con Neural Accelerators (decode ~134 tok/s)
# Ignorado en Linux/Windows
OLLAMA_NEW_ENGINE=1
#
# Para MLX nativo en M4, usar modelo NVFP4 (safetensors):
#   ollama pull qwen3.5:35b-a3b-nvfp4    (22 GB, requiere Ollama compilado con MLX)
# Modelo GGUF (default) usa Metal + Flash Attention — buena performance en M4.
#
# NOTA: Homebrew no incluye el engine MLX compilado.
# Para MLX nativo: compilar desde source (cmake --preset MLX) o usar Ollama.app
# Iniciar con: DYLD_LIBRARY_PATH=/opt/homebrew/lib ollama serve
# O usar: make -C 01-ollama start (ya incluye las variables)

# ── Elegir modelo segun tu RAM disponible ────────────────────
#
# Modelo base del workshop (3B, ~2 GB, soporte oficial para espanol y tool use)
OLLAMA_MODEL=llama3.2
#
# Alternativa opcional: phi4-mini (3.8B, ~2.5 GB, mejor razonamiento/matematica)
#OLLAMA_MODEL=phi4-mini
#
# 32 GB+ RAM → qwen3.5:35b-a3b (MoE, solo 3.5B activos)
#OLLAMA_MODEL=qwen3.5:35b-a3b
#
# 16+ GB RAM → NVFP4 (safetensors) — requiere Ollama.app (no Homebrew), usa MLX nativo
# Decode 2x mas rapido: 83 tok/s vs 40 tok/s (M4 Max)
#OLLAMA_MODEL=qwen3.5:35b-a3b-nvfp4
#
# 32 GB+ RAM → mismo modelo, corre con mas holgura para cluster + servicios
#OLLAMA_MODEL=qwen3.5:35b-a3b
#
# Alternativas:
#OLLAMA_MODEL=llama3.2          # 3B, clasico, 2 GB — funciona en cualquier Mac
#OLLAMA_MODEL=qwen3:30b-a3b     # MoE anterior, 3.3B activos — si ya lo tienes descargado
#OLLAMA_MODEL=mistral-small3    # 7B, rapido en 16 GB

# ── Backstage (opcional — el agente funciona sin el) ────────
BACKSTAGE_URL=http://localhost:7007
BACKSTAGE_TOKEN=

# ── GitHub — REQUERIDO para el flujo GitOps completo ────────
# Crear Fine-grained token en: github.com/settings/tokens?type=beta
#   1. "Only select repositories" → elegir tu repo kcd-demo-apps
#   2. Permissions → Repositories:
#      - Contents:       Read and write  (Backstage pushea manifests YAML)
#      - Pull requests:  Read and write  (Backstage crea PRs, agente las mergea)
#      - Metadata:       Read-only       (se agrega automatico)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=tu-usuario/kcd-demo-apps

# ── ArgoCD — se llena automatico por 03-argocd/make configure
ARGOCD_SERVER=localhost:8080
ARGOCD_PASSWORD=
