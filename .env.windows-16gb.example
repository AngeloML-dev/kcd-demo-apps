# Perfil Windows 16 GB: usar desde WSL2 + Docker Desktop.
# Copiar como .env antes de ejecutar make setup-windows-16gb.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_THINK=false

# Backstage y MCP se excluyen de este perfil para preservar memoria.
BACKSTAGE_URL=http://localhost:7007
BACKSTAGE_TOKEN=

# Opcional: permite activar el flujo GitOps despues del setup base.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=tu-usuario/kcd-demo-apps
ARGOCD_SERVER=localhost:8080
ARGOCD_PASSWORD=
